{% block javascript %}
<script>
    const vehiculeSelect = document.getElementById('assurance_vehicule');
    const imageElement = document.getElementById('materiel-image');
    var $assurance_typemateriel = $("#assurance_typemateriel")
    var $token = $("#assurance__token")


    $assurance_typemateriel.change(function ()
    {
    var $form = $(this).closest( 'form')
    var data = {}
    data[$token.attr('name') ] = $token.val()
    data[$assurance_typemateriel.attr('name')] = $assurance_typemateriel.val()
    $.post($form.attr('action'), data).then(function(response)
    {
        $( "#assurance_vehicule").replaceWith(
        $(response). find ( "#assurance_vehicule")
        )
    })
    })


    document.addEventListener('DOMContentLoaded', function() {
    const imageElement = document.getElementById('materiel-image');
    if (!imageElement) {
    console.error('Élément image non trouvé');
    return;
}

    // Délégation d'événements sur le formulaire parent
    document.querySelector('form[name="assurance"]').addEventListener('change', function(event) {
    if (event.target && event.target.id === 'assurance_vehicule') {
    console.log('Changement détecté sur le select vehicule');
    loadMaterielImage(event.target.value);
}
});

    // Fonction pour charger l'image
    async function loadMaterielImage(materielId) {
    console.log('Chargement image pour le matériel ID:', materielId);
    if (!materielId) {
    imageElement.src = '{{ asset('images/default-image.jpg') }}';
            return;
        }

        try {
            const response = await fetch(`/ajax/image/materiel/${materielId}/`);
            if (!response.ok) throw new Error('Erreur réseau');

            const data = await response.json();
            console.log('Données reçues:', data);

            imageElement.src = data.imageUrl || '{{ asset('images/default-image.jpg') }}';
            imageElement.style.display = 'block';
        } catch (error) {
            console.error('Erreur:', error);
            imageElement.src = '{{ asset('images/default-image.jpg') }}';
        }
    }

    // Pour les cas où le select est déjà rempli au chargement
    const initialVehicule = document.getElementById('assurance_vehicule');
    if (initialVehicule && initialVehicule.value) {
        loadMaterielImage(initialVehicule.value);
    }
});
</script>

{% endblock %}
