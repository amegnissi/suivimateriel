{% extends 'base_table.html.twig' %}
{% block title %}Courrier{% endblock %}
{% block breadcrumb %}Courrier{% endblock %}
{% block  breadcrumb_item %} Courrier{% endblock %}
{% block  breadcrumb_t %} Gestion des courriers{% endblock %}
{% block table_titre %}Mes affectations{% endblock %}

{% block tableContent %}
    <thead>
    <tr>
        <th>Type</th>
        <th>Courrier</th>
        <th>Date affectation </th>
        <th>Date limite</th>
        <th> Affecte par</th>
        <th>  </th>


        <th>actions</th>
    </tr>
    </thead>
    <tbody>
    {% for courrier in affectations %}
        <tr>
            <td>
                {% if courrier.courrier.typeCourrier %}
                    {% if courrier.courrier.typeCourrier.code == "ARRIVEE" %}
                        <span class=" badge bg-warning"> {{ courrier.courrier.typeCourrier.libelle }}</span>
                    {% elseif courrier.courrier.typeCourrier.code == "DEPART" %}
                        <span class=" badge bg-success">
								{{ courrier.courrier.typeCourrier.libelle }}</span>
                    {% elseif courrier.courrier.typeCourrier.code == "INTERNE" %}
                        <span class=" badge bg-info">
								{{ courrier.courrier.typeCourrier.libelle }}</span>
                    {% endif %}
                {% endif %}
            </td>
            <td>
                {{ courrier.courrier.reference }} - ( Réf. interne : {{ courrier.courrier.referenceInterne }} )
            </td>
            <td>{{ courrier.courrier.dateArivee ? courrier.courrier.dateArivee|date('Y-m-d') : '' }}</td>
            <td class="text-center">{{ courrier.dateAffectation ? courrier.dateAffectation|date('Y-m-d') : '' }}</td>
            <td>
                {{ courrier.expediteur.fullName }}
            </td>
            <td>
                {% if courrier.courrier.url %}
                    <a
                            class="btn btn-info btn-sm" href="{{ app.request.schemeAndHttpHost ~ courrier.courrier.fichier
                    }} "
                            target="_blank">


                        {# <i class="bi bi-file"></i> #}
                        <i class="fa fa-file"></i>

                    </a>
                {% endif %}
            </td>

            <td class="align-middle text-center">
                <div class="common-align gap-2 justify-content-start">
                    <a href="{{ path('app_courrier_show', {'id': courrier.courrier.id}) }}" class="btn btn-primary btn-sm">
                        <i class="fa fa-eye"></i>
                    </a>
                </div>
            </td>
        </tr>
    {% else %}
        <tr>
            <td colspan="10">no records found</td>
        </tr>
    {% endfor %}
    </tbody>

    {#    <a href="{{ path('app_courrier_courrier_new') }}">Create new</a>#}
{% endblock %}
