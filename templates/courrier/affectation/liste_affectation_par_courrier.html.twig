{% extends 'baseC.html.twig' %}
{% block title %}Courrier{% endblock %}
{% block breadcrumb %}Courrier{% endblock %}

{% block  breadcrumb_t %} Gestion des courriers{% endblock %}
{% block table_titre %}Liste des affectations{% endblock %}
{% block btntitle %}Details courrier{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-sm-12">
            <div class="card card-primary card-success">
                <div class="card-header">
                    <h3 class="card-title ">
                        Affectations du courrier
                    </h3>
                </div>
                <div class="card-body">
                    <div class="col-sm-12 mb-3">
                        <div class="call callout-info">
                            <div class="row">
                                <div class="col-sm-10">
                                    <h5> Affectation du courrier du {{ courrier.reference }} - ( Réf. interne : {{ courrier
                                        .referenceInterne }} )</h5>
                                </div>
                                <div class="col-sm-1 text-right" >
                                    {% if courrier.url %}
                                        <a
                                                class="btn btn-info btn-sm" href="{{ app.request.schemeAndHttpHost ~ courrier.fichier
                                        }} "
                                                target="_blank">


                                            {# <i class="bi bi-file"></i> #}
                                            <i class="fa fa-file"></i>

                                        </a>
                                    {% endif %}
                                </div>
                                <div class="col-sm-1">
                                    <a href="{{ path('app_courrier_show', {'id': courrier.id}) }}" class="btn btn-primary btn-sm">
                                        <i class="fa fa-eye"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <table id="example1" class="table  table-striped">
                        <thead>
                        <tr>
                            <th>Destinataire</th>
                            <th>Etat</th>
                            <th>Date affectation</th>
                            <th>Date limite de traitement</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for affectation in affectations %}
                            <tr>
                                <td>{{ affectation.destinataire.fullName }} </td>

                                <td>
                                    {% if affectation.traite %}
                                        <small class="badge badge-success">Traité</small>
                                    {% elseif affectation.dateLimiteTraitement and affectation.dateLimiteTraitement <= date() %}
                                        <small class="badge badge-danger">En retard</small>
                                    {% else %}
                                        <small class="badge badge-warning">En attente</small>
                                    {% endif %}
                                </td>
                                <td>{{ affectation.dateLimiteTraitement ? affectation.dateLimiteTraitement|date('d-m-Y') : 'N/A' }}</td>
                                <td>{{ affectation.dateAffectation ?  affectation.dateAffectation |date('d-m-Y') : 'N/A'}}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block breadcrumb_item %}

{% endblock %}

