{% extends 'base_table.html.twig' %}
{% block title %}Courrier{% endblock %}
{% block breadcrumb %}Courrier{% endblock %}
{% block  breadcrumb_item %} Courrier{% endblock %}
{% block  breadcrumb_t %} Gestion des courriers{% endblock %}
{% block table_titre %}Liste des courriers{% endblock %}
 {% block otherbtn %}
   
    <a href="{{ path('app_courrier_new') }}" class="btn btn-secondary align-center ">
        <i class="ion-archive"></i> Nouveau courrier arrivé
    </a>
     <a href="{{ path('app_courrier_depart_new') }}" class="btn btn-primary align-center ">
        <i class="ion-paper-airplane"></i>  Nouveau courrier départ
    </a>
    
{% endblock %}

{% block tableContent %}
        <thead>
            <tr>
            <th class="col">N°</th>
                <th class="col">Type</th>
                <th class="col">Référence</th>
                <th class="col">Date Arrivée</th>

                <th class="col">Objet</th>
                <th class="col text-center">Expéditeurs / Destinataires </th>
                <th class="col"> Fichier </th>

                <th class="col text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for courrier in courriers %}
            <tr>
            <td>{{ loop.index }}</td>
                <td>
                    {% if courrier.typeCourrier %}
                        {% if courrier.typeCourrier.code == "ARRIVEE" %}
                            <span class=" badge bg-warning"> {{ courrier.typeCourrier.libelle }}</span>
                        {% elseif courrier.typeCourrier.code == "DEPART" %}
                            <span class=" badge bg-success">
								{{ courrier.typeCourrier.libelle }}</span>
                        {% elseif courrier.typeCourrier.code == "INTERNE" %}
                            <span class=" badge badge-info">
								{{ courrier.typeCourrier.libelle }}</span>
                        {% endif %}
                    {% endif %}
                </td>
                <td>{{ courrier.referenceInterne }}</td>
                <td>{{ courrier.dateArivee ? courrier.dateArivee|date('Y-m-d') : '' }}</td>
{#                <td>{{ courrier.url }}</td>#}
                <td>{{ courrier.objet }}

                </td>
                <td class="text-center">{{ courrier.partenaire.nomOuRaisonSocial }}</td>
                <td>
                    {% if courrier.url %}
                        <a
                                class="btn text-muted btn-sm" href="{{ app.request.schemeAndHttpHost ~ courrier.fichier
                        }} "
                                target="_blank">


                            {# <i class="bi bi-file"></i> #}
                            <i class="fa fa-file"></i>

                        </a>
                    {% endif %}
                </td>

                <td class="align-middle text-center">
                    <div class="common-align gap-2 justify-content-start">
                        <a href="{{ path('app_courrier_show', {'id': courrier.id}) }}" class="btn  btn-sm">
                            <i class="fa fa-eye"></i>
                        </a>
                        <a href="{{ path('app_courrier_edit', {'id': courrier.id}) }}" class="btn btn-sm">
                            <i class="far fa-edit"></i>
                        </a>
                    </div>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="10">no records found</td>
            </tr>
        {% endfor %}
        </tbody>

{#    <a href="{{ path('app_courrier_courrier_new') }}">Create new</a>#}
{% endblock %}
