{% extends 'base_table.html.twig' %}
{% block title %}Courrier{% endblock %}
{% block breadcrumb %}Courrier{% endblock %}
{% block  breadcrumb_item %} Courrier{% endblock %}
{% block  breadcrumb_t %} Gestion des Partenaires{% endblock %}
{% block table_titre %}Liste des partenaires{% endblock %}
{% block btntitle %}Ajouter un partenaire{% endblock %}

{% block btnpath %}{{ path('app_courrier_partenaire_new') }}{% endblock %}

{% block tableContent %}
        <thead>
            <tr>
                <th>Id</th>
                <th>Dénomination </th>
                <th>Telephone</th>
                <th>Email</th>

                <th></th>
            </tr>
        </thead>
        <tbody>
        {% for partenaire in partenaires %}
            <tr>
                <td>{{ partenaire.id }}</td>
                <td>{{ partenaire.nomOuRaisonSocial }}</td>
                <td>{{ partenaire.telephone }}</td>
                <td>{{ partenaire.email }}</td>

                <td class="align-middle text-center">
                    <div class="common-align gap-2 justify-content-start">
                        <a href="{{ path('app_courrier_partenaire_show', {'id': partenaire.id}) }}" class="btn btn-primary btn-sm">
                            <i class="fa fa-eye"></i>
                        </a>
                        <a href="{{ path('app_courrier_partenaire_edit', {'id': partenaire.id}) }}" class="btn btn-success btn-sm">
                            <i class="far fa-edit"></i>
                        </a>
                    </div>
                </td>

            </tr>
        {% else %}
            <tr>
                <td colspan="8">no records found</td>
            </tr>
        {% endfor %}
        </tbody>



{% endblock %}
