{% extends 'base-dashboard.html.twig' %}

{% block title %}Courrier{% endblock %}
{% block breadcrumb %}Courrier{% endblock %}
{% block  breadcrumb_item %} Courrier{% endblock %}
{% block  breadcrumb_t %} Gestion des Partenaires{% endblock %}
{% block table_titre %}Liste des partenaires{% endblock %}
{% block btntitle %}Details partenaire{% endblock %}

{% block content %}

    <div class="row">

        <div class="col-sm-12">
            <div class="card __cadr-default">
                <div class="card-header">
                    <h3 class="card-title ">
                        {{ partenaire.nomOuRaisonSocial }}
                    </h3>
                </div>
                <!-- /.card-header -->
                <div class="card-body table-responsive">
                    <table class="table table-bordered table-striped__ table-hover text-nowrap table-valign-middle">
                        <tbody>

                        <tr>
                            <th>Dénomination</th>
                            <td>{{ partenaire.nomOuRaisonSocial }}</td>
                        </tr>
                        <tr>
                            <th>Telephone</th>
                            <td>{{ partenaire.telephone }}</td>
                        </tr>
                        <tr>
                            <th>Email</th>
                            <td>{{ partenaire.email }}</td>
                        </tr>
                        <tr>
                            <th>Adresse</th>
                            <td>{{ partenaire.adresse }}</td>
                        </tr>

                        </tbody>
                    </table>

                </div>
                <!-- /.card-body -->
            </div>

        </div>

        <div class="col-sm-12">
            <div class="card ">
                <div class="card-header">
                    <h3 class="card-title ">
                        Historique des courriers
                    </h3>
                </div>
                <!-- /.card-header -->
                <div class="card-body table-responsive">
                    <table
                            id="example1"
                            class="table table-bordered table-striped__ table-hover text-nowrap table-valign-middle">
                        <thead>
                        <tr>
                            <th>Type</th>
                            <th>Référence</th>
                            <th>Référence interne</th>
                            <th>Date Arrivée</th>

                            <th>Objet</th>

                            <th>Fichier</th>

                            <th>actions</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for courrier in courriers %}
                            <tr>
                                <td>
                                    {% if courrier.typeCourrier %}
                                        {% if courrier.typeCourrier.code == "ARRIVEE" %}
                                            <span class=" badge bg-warning"> {{ courrier.typeCourrier.libelle }}</span>
                                        {% elseif courrier.typeCourrier.code == "DEPART" %}
                                            <span class=" badge bg-success">
								{{ courrier.typeCourrier.libelle }}</span>
                                        {% elseif courrier.typeCourrier.code == "INTERNE" %}
                                            <span class=" badge bg-info">
								{{ courrier.typeCourrier.libelle }}</span>
                                        {% endif %}
                                    {% endif %}
                                </td>
                                <td>{{ courrier.reference }}</td>
                                <td>{{ courrier.referenceInterne }}</td>
                                <td>{{ courrier.dateArivee ? courrier.dateArivee|date('Y-m-d') : '' }}</td>
                                {#                <td>{{ courrier.url }}</td> #}
                                <td>{{ courrier.objet }}</td>

                                <td>
                                    {% if courrier.url %}
                                        <a
                                                class="btn btn-info btn-sm"
                                                href="{{ app.request.schemeAndHttpHost ~ courrier.fichier }} "
                                                target="_blank">


                                            {# <i class="bi bi-file"></i> #}
                                            <i class="fa fa-file"></i>

                                        </a>
                                    {% endif %}
                                </td>

                                <td class="align-middle text-center">
                                    <div class="common-align gap-2 justify-content-start">
                                        <a href="{{ path('app_courrier_show', {'id': courrier.id}) }}"
                                           class="btn btn-primary btn-sm">
                                            <i class="fa fa-eye"></i>
                                        </a>
                                        <a href="{{ path('app_courrier_edit', {'id': courrier.id}) }}"
                                           class="btn btn-primary btn-sm">
                                            <i class="far fa-edit"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="10">no records found</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
                <!-- /.card-body -->
            </div>

        </div>
    </div>



    <a href="{{ path('app_partenaires_index') }}">back to list</a>

    <a href="{{ path('app_partenaire_edit', {'id': partenaire.id}) }}">edit</a>

    {{ include('courrier/partenaire/_delete_form.html.twig') }}
{% endblock %}
