{# templates/components/page_title.html.twig #}
<div class="page-title-box mb-4">
    <div class="row align-items-center justify-content-between">
        <div class="col-md-6 col-sm-12">
            <div class="d-flex align-items-center gap-2">
                {% if icon is defined %}
                    <i class="{{ icon }} fs-4 text-primary"></i>
                {% endif %}
                <h4 class="mb-0 fw-bold">{{ title }}</h4>
            </div>
            {% if description is defined %}
                <p class="text-muted mt-1 mb-0 small">{{ description }}</p>
            {% endif %}
        </div>

        <div class="col-md-6 col-sm-12 text-md-end text-start mt-2 mt-md-0">
            {% if actions is defined and actions|length > 0 %}
                {% for action in actions %}
                    <a href="{{ action.url }}" class="btn btn-sm btn-{{ action.type|default('primary') }} ms-1">
                        {% if action.icon is defined %}
                            <i class="{{ action.icon }}"></i>
                        {% endif %}
                        {{ action.label }}
                    </a>
                {% endfor %}
            {% endif %}
        </div>
    </div>

    {% if breadcrumb is defined and breadcrumb is iterable and breadcrumb|length > 0 %}
        <div class="row mt-2">
            <div class="col">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item">
                        <a href="{{ path('dashboard') }}">Accueil</a>
                    </li>
                    {% for item in breadcrumb %}
                        <li class="breadcrumb-item {{ loop.last ? 'active' : '' }}">
                            {% if not loop.last and item.url is defined %}
                                <a href="{{ item.url }}">{{ item.label }}</a>
                            {% else %}
                                {{ item.label }}
                            {% endif %}
                        </li>
                    {% endfor %}
                </ol>
            </div>
        </div>
    {% endif %}
</div>
