{# templates/components/page_title.html.twig #}
<div class="page-title-box mb-4">
    <div class="row align-items-center justify-content-between">
        <div class="col-md-6 col-sm-12">
            <div class="d-flex align-items-center gap-2">
                {% if icon is defined %}
                    <i class="{{ icon }} fs-4 text-primary"></i>
                {% endif %}
                <h4 class="mb-0 fw-bold">{% block title %}Titre{% endblock %}</h4>
            </div>
            {% if block('breadcrumb_t') is not empty %}
                <p class="text-muted mt-1 mb-0 small">{{ block('breadcrumb_t') }}</p>
            {% endif %}
        </div>

        <div class="col-md-6 col-sm-12 text-md-end text-start mt-2 mt-md-0">
            <div class="d-flex flex-wrap justify-content-md-end justify-content-start gap-1">
                {% if block('otherbtn') is not empty %}
                    {{ block('otherbtn') }}
                {% endif %}
                {% if block('btnpath') is not empty %}
                    <a href="{{ block('btnpath') }}" class="btn btn-sm btn-primary">
                        {{ block('btntitle')|default('Ajouter') }}
                    </a>
                {% endif %}
            </div>
        </div>
    </div>

    {% if block('breadcrumb') is not empty %}
        <div class="row mt-2">
            <div class="col">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item">
                        <a href="{{ path('dashboard') }}">Accueil</a>
                    </li>
                    {% if block('breadcrumb_item') is not empty %}
                        <li class="breadcrumb-item active">
                            {{ block('breadcrumb_item') }}
                        </li>
                    {% endif %}
                </ol>
            </div>
        </div>
    {% endif %}
</div>
