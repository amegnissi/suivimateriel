{% extends 'base-dashboard.html.twig' %}
{% block css %}

    <link rel="stylesheet"
          href="{{ asset('adminlte/plugins/datatables/datatables.css') }}">

    <!-- DataTables -->

{% endblock %}
{% block title %}{% endblock %}

{#{% block breadcrumb %}{% endblock %}#}
{#{% block  breadcrumb_item %}{% endblock %}#}
{#{% block  breadcrumb_t %} {% endblock %}#}
{% block content %}
       
        <!-- /.container-fluid -->

        <div class="row">

            <div class="col-sm-12">
                <div class="card__cadr-default">
                    <!-- /.card-header -->
                    <div class="card-body table-responsive ">
                        {% block filtre %}

                        {% endblock %}
                            <table
                                    id="example1"
                                    class="table border overflow-hidden table-bordered__table-striped__ table-hover text-nowrap table-valign-middle">
                                {% block tableContent %}
                                {% endblock %}
                            </table>

                        {% block panigination %}
                        {% endblock %}
                    </div>
                    <!-- /.card-body -->
                </div>

            </div>
        </div>


{% endblock %}
{% block javascript %}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script src="{{ asset('adminlte/plugins/datatables/jquery.dataTables.js') }}"></script>
<script src="{{ asset('adminlte/plugins/datatables/datatables.js') }}"></script>


<script>
    $(document).ready(function () {
        // Vérifie si le tableau a au moins des ligne
         if ($("#example1 tbody tr").length > 10) {
            const table1 = $("#example1").DataTable({
                responsive: true,
                lengthChange: false,
                autoWidth: false,
                buttons: ["copy", "csv", "excel", "pdf", "print", "colvis"],
                language: {
                    url: "{{ absolute_url(asset('data/locales/datatables/i18n/fr-FR.json')) }}"
                }
            });

            table1.buttons().container().appendTo('#example1_wrapper .col-md-6:eq(0)');
        }
    });
</script>

{% endblock %}
