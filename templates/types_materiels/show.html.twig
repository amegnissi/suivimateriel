{% extends 'base-dashboard.html.twig' %}

{% block title %}Materiel{% endblock %}
{% block breadcrumb %}Materiel{% endblock %}
{% block  breadcrumb_item %} Courrier{% endblock %}
{% block  breadcrumb_t %} Gestion des materiels{% endblock %}
{% block table_titre %}Type Matériel{% endblock %}
{% block btntitle %}Type Matériel{% endblock %}


{% block content %}

    <div class="row">
        <div class="col-12">
            <div class="card __cadr-default">
                <div class="card-header">
                    <h3 class="card-title ">
                        <i class="fas fa-edit"></i> Détails du Type de Matériel : {{ typeMateriel.libelle }}
                    </h3>
                </div>
                <div class="card-body table-responsive">
                    <p><strong>Nombre de matériels associés :</strong> {{ typeMateriel.materiels|length }}</p>

                    <table class="table table-bordered table-striped__ table-hover text-nowrap table-valign-middle">
                        <thead>
                        <tr>
                            <th>Materiel</th>
                            <th>Date acquisition</th>
                          {#  <th>Etat</th>
                            <th> Statut</th>#}
                        </tr>
                        </thead>
                        <tbody>
                        {% for materiel in typeMateriel.materiels %}
                        <tr>
                            <td>
                                {% if typeMateriel.libelle == "Véhicule" %}
                                   {{ materiel.marque ? materiel.marque.libelle : materiel.name }} - {{ materiel.immatriculation }}
                                {% else %}
                                   {{ materiel.name }} - {{ materiel.code }}
                                {% endif %}
                            </td>
                            <td>{{ materiel.dateAcquisition ? materiel.dateAcquisition|date('d-m-Y') :"" }}</td>
                           {# <td>{{ materiel.statut }}</td>
                            <td> {{ materiel.statutMateriel }}</td>#}
                        </tr>
                        {% else %}
                            <tr>
                                <td colspan="4">Aucun matériel associé à ce type.</td>
                            </tr>
                        {% endfor %}
                        </tbody>

                    </table>
                </div>
                <div class="card-footer">
                        <div class="float-end">
                            <a href="{{ path('types_materiels_edit', { 'id': typeMateriel.id }) }}" class="btn btn-default">Modifier</a>
                            <form action="{{ path('types_materiels_delete', {'id': typeMateriel.id}) }}" method="POST" class="d-inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ typeMateriel.id) }}">
                                <button type="submit" class="btn btn-danger" onclick="return confirm('Êtes-vous sûr de vouloir supprimer ce type de matériel ?');">Supprimer</button>
                            </form>

                            <a href="{{ path('types_materiels_index') }}" class="btn btn-secondary">Retour</a>
                        </div>


                </div>
            </div>
        </div>
    </div>

{% endblock %}