        has_logo:'Yes',
        bg_navbar:'bg-start-nav'
    } %}
<!-- /.navbar -->

<div id="main-login">

<div class="container justify-content-center align-items-center d-flex flex-column">
<h1 class="text-suse px-2 px-md-0 text-center mt-sm-1 mt-lg-2 mt-xl-3 mt-2xl-4 mt-0 fw-bold"> Bienvenue sur E-SUIVI </h1>
