    // Optionnel : Gestion sélection période (ex: après clic sur "Selectionner")
    document.addEventListener('click', function(e) {
    if (e.target.classList.contains('selectionner-btn')) {
    const selectedPeriode = document.querySelector('input[name="periode_selected"]:checked');
    if (selectedPeriode) {
    const periodeData = {
    periodeId: selectedPeriode.value,
}
    console.log(`Période sélectionnée: ${selectedPeriode.value}`);
    // Ici : Appel AJAX pour charger les données prix, ou submit form
    // e.g., window.location.href = `/edit-prix/${selectedExerciceId}/${selectedPeriode.value}`;
