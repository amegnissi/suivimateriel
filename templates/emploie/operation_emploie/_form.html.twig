{{ form_start(form) }}
<div class="row">
    <div class="col-md-4"> {{ form_row(form.designation) }}</div>
    <div class="col-md-4">{{ form_row(form.referenceManuel) }}</div>
    <div class="col-md-4"> {{ form_row(form.dateOperation) }}</div>
</div>
<div class="row">
    <div class="col-md-6">{{ form_row(form.annee) }}</div>
    <div class="col-md-6"> {{ form_row(form.mois) }}</div>

<div class="row">
    <div class="col-md-4">{{ form_row(form.montantAPayer) }}</div>
    <div class="col-md-4"> {{ form_row(form.retenue) }}</div>
    <div class="col-md-4"> {{ form_row(form.netAPayer) }}</div>
    <div class="col-md-12"> {{ form_row(form.caisse) }}</div>
</div>
{{ form_widget(form) }}
