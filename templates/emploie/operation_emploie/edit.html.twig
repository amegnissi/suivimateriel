{% extends 'base_formulaire.html.twig' %}
{% block title %}Exercice 2025 mois de Septembre{% endblock %}
{% block breadcrumb %}Emploie{% endblock %}
{% block  breadcrumb_item %} Ressources{% endblock %}
{% block  breadcrumb_t %} Emploie & Ressources{% endblock %}
{% block form_titre %}Nouvel emploi{% endblock %}
{% block formContent %}

    {{ include('emploie/operation_emploie/_form.html.twig') }}


{% endblock %}
{% block javascript %}
<script>
    document.addEventListener("DOMContentLoaded", function () {
    const montantInput = document.querySelector("#operation_emploie_montantAPayer");
    const retenueInput = document.querySelector("#operation_emploie_retenue");
    const netInput = document.querySelector("#operation_emploie_netAPayer");
    const caisseSelect = document.querySelector("#operation_emploie_caisse");

    function updateFields() {
    let montant = parseFloat(montantInput.value) || 0;
    let retenue = parseFloat(retenueInput.value) || 0;

    // Empêcher que la retenue soit > montant
    if (retenue > montant) {
    retenue = montant;
    retenueInput.value = montant;
}

    // Calcul du net à payer
    const net = montant - retenue;
    netInput.value = net >= 0 ? net : 0;

    // Activer ou désactiver la caisse
    caisseSelect.disabled = (retenue <= 0);
}

    // Force le grisé au chargement
    caisseSelect.disabled = true;

    // Événements sur les champs
    montantInput.addEventListener("input", updateFields);
    retenueInput.addEventListener("input", updateFields);

    // Calcul initial au chargement (au cas où des valeurs existent déjà)
    updateFields();
});
</script>
{% endblock %}
