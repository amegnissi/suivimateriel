            "searching": false,
            "ordering": true,
            "info": true,
            "autoWidth": false,
            "responsive": true,
        });
    });

	</script>
 <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Configuration et éléments DOM
            const config = {
                elements: {
                    btnAddEmploie: document.getElementById('btn-add-emploie'),
                    modalFormContent: document.getElementById('modal-form-content'),
                    emploiesTbody: document.getElementById('emploies-tbody'),
                    modalTitle: document.getElementById('emploieModalLabel')
                },
                modal: new bootstrap.Modal(document.getElementById('emploieModal')),
                state: {
                    isEditMode: false,
                    currentEmploieId: null
                },
                urls: {
                    modalForm: '{{ path('app_emploie_emploie_modal_form') }}',
                    modalEditForm: '{{ path('app_emploie_modification_modal_edit_form', {'id': '__ID__'}) }}',
                    showEmploie: '{{ path('app_emploie_emploie_show', {'id': '__ID__'}) }}'
                }
            };

            // Initialisation des événements
            initEventListeners(config);

            /**
             * Initialise tous les écouteurs d'événements
             */
            function initEventListeners(config) {
                // Événement pour l'ajout
                // config.elements.btnAddEmploie.addEventListener('click', () => {
                //     openModal(config, false);
                // });

                // Événement pour la modification (délégation d'événement)
                document.addEventListener('click', function(e) {
                    if (e.target.classList.contains('btn-edit-emploie')) {
                        const emploieId = e.target.getAttribute('data-emploie-id');
                        openModal(config, true, emploieId);
                    }
                });
            }

            /**
             * Ouvre le modal pour ajout ou modification
             */
            function openModal(config, isEdit, emploieId = null) {
                config.state.isEditMode = isEdit;
                config.state.currentEmploieId = emploieId;

                // Mise à jour du titre du modal
                config.elements.modalTitle.textContent = isEdit ? 'Dmande d\'autorisation de modification' : 'Dmande d\'autorisation de modification';

                // URL à utiliser
                const url = isEdit
                    ? config.urls.modalEditForm.replace('__ID__', emploieId)
                    : config.urls.modalForm;

                // Chargement du formulaire
                loadModalForm(config, url);
            }

            /**
             * Charge le formulaire dans le modal
             */
            function loadModalForm(config, url) {
                fetch(url)
                    .then(response => response.text())
                    .then(html => {
                        config.elements.modalFormContent.innerHTML = html;
                        config.modal.show();
                        attachFormSubmitEvent(config);
                    })
                    .catch(error => {
                        console.error('Erreur lors du chargement du formulaire:', error);
                        showAlert('Erreur lors du chargement du formulaire', 'danger');
                    });
            }

            /**
             * Attache l'événement de soumission au formulaire
             */
            function attachFormSubmitEvent(config) {
                const form = config.elements.modalFormContent.querySelector('form');
                if (form) {
                    form.addEventListener('submit', function(e) {
                        e.preventDefault();
                        handleFormSubmission(config, form);
                    });
                }
            }

            /**
             * Gère la soumission du formulaire
             */
            function handleFormSubmission(config, form) {
                const formData = new FormData(form);

                fetch(form.action, {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                })
                    .then(response => response.json())
                    .then(data => {
                        handleFormResponse(config, data);
                    })
                    .catch(error => {
                        console.error('Erreur lors de la soumission:', error);
                        showAlert('Erreur lors de la soumission du formulaire', 'danger');
                    });
            }

            /**
             * Gère la réponse du formulaire
             */
            function handleFormResponse(config, data) {
                if (data.success) {
                    // Fermer le modal
                    config.modal.hide();

                    // Afficher un message de succès
                    showAlert(data.message, 'success');

                    // Mettre à jour le tableau
                    updateTable(config, data.emploie);
                } else {
                    // Gestion des erreurs
                    handleFormErrors(config, data);
                }
            }

            /**
             * Met à jour le tableau après succès
             */
            function updateTable(config, emploie) {
                if (config.state.isEditMode) {
                    updateRowInTable(config, emploie);
                } else {
                    addRowToTable(config, emploie);
                    removeNoRecordsRow();
                }
            }

            /**
             * Gère les erreurs de formulaire
             */
            function handleFormErrors(config, data) {
                if (data.form) {
                    config.elements.modalFormContent.innerHTML = data.form;
                    attachFormSubmitEvent(config);
                }

                if (data.errors && data.errors.length > 0) {
                    showAlert(data.errors.join('<br>'), 'danger');
                }
            }

            /**
             * Met à jour une ligne existante dans le tableau
             */
            function updateRowInTable(config, emploie) {
                const row = document.querySelector(`tr[data-emploie-id="${emploie.id}"]`);
                if (row) {
                    row.innerHTML = createRowHTML(config, emploie);
                }
            }

            /**
             * Ajoute une nouvelle ligne au tableau
             */
            function addRowToTable(config, emploie) {
                const newRow = document.createElement('tr');
                newRow.setAttribute('data-emploie-id', emploie.id);
                newRow.innerHTML = createRowHTML(config, emploie);
                config.elements.emploiesTbody.appendChild(newRow);
            }

            /**
             * Crée le HTML pour une ligne de tableau
             */
            function createRowHTML(config, emploie) {
                const showUrl = config.urls.showEmploie.replace('__ID__', emploie.id);
                return `
                <td>${emploie.id}</td>
                <td>${emploie.libelle}</td>
                <td>
                    <a href="${showUrl}" class="btn btn-info btn-sm">Voir</a>
                    <button type="button" class="btn btn-warning btn-sm btn-edit-emploie" data-emploie-id="${emploie.id}">Modifier</button>
                </td>
            `;
            }

            /**
             * Supprime la ligne "Aucun enregistrement"
             */
            function removeNoRecordsRow() {
                const noRecordsRow = document.getElementById('no-records-row');
                if (noRecordsRow) {
                    noRecordsRow.remove();
                }
            }

            /**
             * Affiche une alerte
             */
            function showAlert(message, type) {
                const alertDiv = document.createElement('div');
                alertDiv.className = `alert alert-${type} alert-dismissible fade show`;
                alertDiv.innerHTML = `
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            `;

                // Insérer l'alerte avant le tableau
                const tableContainer = document.querySelector('.table-responsive');
                if (tableContainer) {
                    tableContainer.parentNode.insertBefore(alertDiv, tableContainer);
                }

                // Supprimer l'alerte après 5 secondes
                setTimeout(() => {
                    if (alertDiv.parentNode) {
                        alertDiv.remove();
                    }
                }, 5000);
            }
        });
    </script>
{% endblock %}
