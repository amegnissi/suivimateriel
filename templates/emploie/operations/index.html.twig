{% extends 'base-dashboard.html.twig' %}
{% block css %}

    <link rel="stylesheet"
          href="{{ asset('adminlte/plugins/datatables/datatables.css') }}">

    <!-- DataTables -->

{% endblock %}
{% block title %}{% endblock %}

{#{% block breadcrumb %}{% endblock %}#}
{#{% block  breadcrumb_item %}{% endblock %}#}
{#{% block  breadcrumb_t %} {% endblock %}#}
{% block content %}

    <!-- /.container-fluid -->

    <div class="row">

        <div class="col-sm-12">
            <div class="card__cadr-default">
                <div class="card-header">
                    <div class="row g-4 align-items-center">
                        <div class="col-sm">
                            <h3 class="card-title mb-0">
                                Liste des emploies
                            </h3>
                        </div>
                        <div class="col-sm-auto">
                            <div class="d-flex flex-wrap align-items-start gap-2">
                                <a data-pjax href="{{ path('app_emploie_operation_emploie_new') }}" class="btn btn-primary btn-sm">
                                    <i class="fa fa-plus"></i>  Ajouter une emploie
                                </a>

                                {#                                {% block autresbtn %}{% endblock %}#}
                            </div>

                        </div>

                    </div>
                </div>
                <div class="card-body table-responsive">
{#                  filtre#}
                    <table
                            id="example1"
                            class="table table-bordered table-striped__ table-hover text-nowrap table-valign-middle">
                        <thead>
                        <tr>
                            <th>#</th>
                            <th>Date</th>
                            <th>Reference</th>

                            <th>Montant à payer</th>
                            <th>Retenue à faire</th>
                            <th>Montant net</th>
                            <th>actions</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for operation_emploie in operation_emploies %}
                            <tr>
                                <td>{{ loop.index }}</td>
                                <td>{{ operation_emploie.reference }}</td>
                                <td>{{ operation_emploie.dateOperation ? operation_emploie.dateOperation|date('Y-m-d') : '' }}</td>
                                <td>{{ operation_emploie.montantAPayer }}</td>
                                <td>{{ operation_emploie.retenue }}</td>
                                <td>{{ operation_emploie.montantAPayer -operation_emploie.retenue }}</td>
                                <td>
                                    <a href="{{ path('app_emploie_operation_emploie_show', {'id': operation_emploie.id}) }}">show</a>
                                    <a href="{{ path('app_emploie_operation_emploie_edit', {'id': operation_emploie.id}) }}">edit</a>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6">no records found</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>


                </div>
                <!-- /.card-body -->
            </div>

        </div>
    </div>

    <div class="row">

        <div class="col-sm-12">
            <div class="card__cadr-default">
                <div class="card-header">
                    <div class="row g-4 align-items-center">
                        <div class="col-sm">
                            <h3 class="card-title mb-0">
                                Liste des operations
                            </h3>
                        </div>
                        <div class="col-sm-auto">
                            <div class="d-flex flex-wrap align-items-start gap-2">
                                <a data-pjax href="{{ path('app_emploie_ressource_new') }}" class="btn btn-primary btn-sm">
                                    <i class="fa fa-plus"></i>  Ajouter une ressource
                                </a>

{#                                {% block autresbtn %}{% endblock %}#}
                            </div>

                        </div>

                    </div>
                </div>
                <div class="card-body table-responsive">

                    <table
                            id="example2"
                            class="table table-bordered table-striped__ table-hover text-nowrap table-valign-middle">
                        <thead>
                        <tr>
                            <th>#</th>
                            <th>Reference</th>
                            <th>Annee</th>
                            <th>Mois</th>
                            <th>Sources de paiement</th>
                            <th>Montant pris</th>
                            <th>Reste a chercher</th>

                            <th>actions</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for ressource in ressources %}
                            <tr>
                                <td>{{loop.index}}</td>
                                <td>{{ ressource.reference }}</td>
                                <td>{{ ressource.annee }}</td>
                                <td>{{ ressource.nomMois }}</td>
                                <td>{{ ressource.sourcesPaiement }}</td>
                                <td>{{ ressource.montantPris }}</td>
                                <td>{{ ressource.montantRestant }}</td>
                                <td>
                                    <a href="{{ path('app_emploie_ressource_show', {'id': ressource.id}) }}">show</a>
                                    <a href="{{ path('app_emploie_ressource_edit', {'id': ressource.id}) }}">edit</a>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="8">no records found</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>


                </div>
                <!-- /.card-body -->
            </div>

        </div>
    </div>



{% endblock %}
{% block javascript %}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<!-- DataTables  & Plugins -->
<script src="{{ asset('adminlte/plugins/datatables/jquery.dataTables.js') }}"></script>
<script src="{{ asset('adminlte/plugins/datatables/datatables.js') }}"></script>

	<script>

    $(function () {
        $("#example1").DataTable({
            "responsive": true, "lengthChange": false, "autoWidth": false,
            "buttons": ["copy", "csv", "excel", "pdf", "print", "colvis"],
             language: {
        url: '//cdn.datatables.net/plug-ins/2.0.8/i18n/fr-FR.json',
    },
        }).buttons().container().appendTo('#example1_wrapper .col-md-6:eq(0)');
        $('#example2').DataTable({
            "paging": true,
            "lengthChange": false,
            "searching": false,
            "ordering": true,
            "info": true,
            "autoWidth": false,
            "responsive": true,
        });
    });

	</script>

{% endblock %}
