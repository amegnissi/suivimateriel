<div class="table-responsive">
    <table class="table">
        <tbody>
        <tr>
            <td>Référence</td>
            <td> <strong>{{ emploie.referenceManuel }}</strong> </td>
            <td>Période</td>
            <td> <strong>{{ emploie.nomMois }} {{ emploie.annee }}</strong></td>
        </tr>
        <tr>
            <td>Désignation</td>
            <td> <strong>{{ emploie.designation.libelle }}</strong> </td>
            <td>Retenue</td>
            <td> <strong>{{ emploie.retenue }}</strong></td>

        </tr>
        <tr>
            <td>Montant de l'emploi</td>
            <td colspan="3" class="text-center"> <strong>{{ emploie.montantAPayer |number_format(0,',', ' ') }}
                </strong></td>
        </tr>
        <tr>
            <td >Caisse retenue</td>
            <td colspan="3"> <strong>{{ emploie.caisse.libelle }}</strong></td>
        </tr>
        </tbody>
    </table>
</div>
{% if is_edit is defined and is_edit %}
    {{ form_start(form, {'action': path('app_emploie_operations_autorisation_modification', {'id': emploie.id}), 'method': 'POST'}) }}
{% else %}
    {{ form_start(form, {'action': path('app_emploie_emploie_new'), 'method': 'POST'}) }}
{% endif %}

<div class="mb-3">
{#    {{ form_label(form.libelle, 'Libellé', {'label_attr': {'class': 'form-label'}}) }}#}
    {{ form_row(form.motifAutorisation, {'attr': {'class': 'form-control'}}) }}
{#    {{ form_errors(form.libelle) }}#}
</div>

{# Inclure les autres champs de votre formulaire ici selon votre EmploieType #}

<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
    {% if is_edit is defined and is_edit %}
        <button type="submit" class="btn btn-success">Valider ma demande</button>
    {% else %}
        <button type="submit" class="btn btn-primary">Sauvegarder</button>
    {% endif %}
</div>

{{ form_rest(form) }}
{{ form_end(form) }}
