    <div class="accordion mt-5" id="accordionConsommations">
        {% for annee, excercices in excerciesCloturees %}
            <h3>Exercice : {{ annee }}</h3>

            <div class="accordion" id="accordion{{ annee }}">
                {% for excercies in excercices %}
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="heading{{ annee }}-{{ loop.index }}">
                            <button class="accordion-button {{ not loop.first ? 'collapsed' }}"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#collapse{{ annee }}-{{ loop.index }}"
                                    aria-expanded="{{ loop.first ? 'true' : 'false' }}"
                                    aria-controls="collapse{{ annee }}-{{ loop.index }}">
                                {{ excercies.mois.libelle }}
                            </button>
                        </h2>

                        <div id="collapse{{ annee }}-{{ loop.index }}"
                             class="accordion-collapse collapse {{ loop.first ? 'show' }}"
                             aria-labelledby="heading{{ annee }}-{{ loop.index }}"
                             data-bs-parent="#accordion{{ annee }}">

                            <div class="accordion-body p-0">

                                {# === Tableau des emplois === #}
                                <h3 class="card-title m-3">Tableau des emplois</h3>
                                <div class="p-3">
                                    <table class="table table-bordered table-hover text-nowrap">
                                        <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>Date</th>
                                            <th>Référence</th>
                                            <th>Année</th>
                                            <th>Mois</th>
                                            <th>Désignation</th>
                                            <th>Montant à payer</th>
                                            <th>Retenue</th>
                                            <th>Caisse</th>
                                            <th>Montant net</th>
                                            <th>Actions</th>
                                        </tr>
                                        </thead>
                                        <tbody>
                                        {% set montantAPayer = 0 %}
                                        {% set montantRetenue = 0 %}
                                        {% for operation_emploie in excercies.operationEmploies %}
                                            {% if operation_emploie.isclotured %}
                                                {% set montantAPayer = montantAPayer + operation_emploie.montantAPayer %}
                                                {% set montantRetenue = montantRetenue + operation_emploie.retenue %}
                                                <tr class="emploi-row" data-product-id="{{ operation_emploie.id }}">
                                                    <td>{{ loop.index }}</td>
                                                    <td>{{ operation_emploie.dateOperation ? operation_emploie.dateOperation|date('Y-m-d') }}</td>
                                                    <td>{{ operation_emploie.referenceManuel }}</td>
                                                    <td>{{ operation_emploie.annee }}</td>
                                                    <td>{{ operation_emploie.nomMois }}</td>
                                                    <td>{{ operation_emploie.designation.libelle }}</td>
                                                    <td>{{ operation_emploie.montantAPayer|number_format(0, ',', ' ') }}</td>
                                                    <td>{{ operation_emploie.retenue|number_format(0, ',', ' ') }}</td>
                                                    <td>{{ operation_emploie.caisse ? operation_emploie.caisse.libelle }}</td>
                                                    <td>{{ (operation_emploie.montantAPayer - operation_emploie.retenue)|number_format(0, ',', ' ') }}</td>
                                                    <td class="text-center">
                                                        {# actions boutons ici #}
                                                    </td>
                                                </tr>
                                            {% endif %}
                                        {% else %}
                                            <tr><td colspan="11">Aucun emploi trouvé</td></tr>
                                        {% endfor %}
                                        </tbody>
                                    </table>
                                </div>

                                {# === Tableau des ressources === #}
                                <h3 class="card-title m-3">Tableau des ressources</h3>
                                <div class="p-3">
                                    <table class="table table-bordered table-hover text-nowrap">
                                        <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>Référence</th>
                                            <th>Année</th>
                                            <th>Mois</th>
                                            <th>Source de paiement</th>
                                            <th>Montant provisionné</th>
                                            <th>Solde des opérations</th>
                                        </tr>
                                        </thead>
                                        <tbody>
                                        {% set montantPris = 0 %}
                                        {% set montantRestant = 0 %}
                                        {% for ressource in excercies.ressource %}
                                            {% if ressource.isclotured %}
                                                {% set montantPris = montantPris + ressource.montantPris %}
                                                {% set montantRestant = montantRestant + ressource.montantRestant %}
                                                <tr class="ressource-row" data-product-id="{{ ressource.id }}">
                                                    <td>{{ loop.index }}</td>
                                                    <td>{{ ressource.referenceManuel }}</td>
                                                    <td>{{ ressource.annee }}</td>
                                                    <td>{{ ressource.nomMois }}</td>
                                                    <td>{{ ressource.sourcesPaiement }}</td>
                                                    <td>{{ ressource.montantPris|number_format(0, ',', ' ') }}</td>
                                                    <td style="background-color: {{ ressource.montantRestant > 0 ? 'green' : 'red' }}; color: white">
                                                        {{ ressource.montantRestant|number_format(0, ',', ' ') }}
                                                    </td>
                                                </tr>
                                            {% endif %}
                                        {% else %}
                                            <tr><td colspan="7">Aucune ressource trouvée</td></tr>
                                        {% endfor %}
                                        </tbody>
                                    </table>
                                </div>

                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endfor %}
    </div>

{% endblock %}
