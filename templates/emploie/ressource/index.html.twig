{% extends 'base.html.twig' %}

{% block title %}Ressource index{% endblock %}

{% block body %}
    <h1>Ressource index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Mois</th>
                <th>Annee</th>
                <th>SourcesPaiement</th>
                <th>MontantPris</th>
                <th>MontantRestant</th>
                <th>Reference</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for ressource in ressources %}
            <tr>
                <td>{{ ressource.id }}</td>
                <td>{{ ressource.mois }}</td>
                <td>{{ ressource.annee }}</td>
                <td>{{ ressource.sourcesPaiement }}</td>
                <td>{{ ressource.montantPris }}</td>
                <td>{{ ressource.montantRestant }}</td>
                <td>{{ ressource.reference }}</td>
                <td>
                    <a href="{{ path('app_emploie_ressource_show', {'id': ressource.id}) }}">show</a>
                    <a href="{{ path('app_emploie_ressource_edit', {'id': ressource.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="8">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_emploie_ressource_new') }}">Create new</a>
{% endblock %}
