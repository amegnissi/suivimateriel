{#                    {{ form_errors(child) }}#}
{#                </div>#}
{#            {% endif %}#}
{#        {% endfor %}#}

    <div class="row" >
        <div class="col-md-6">
            {{ form_row(form.marque) }}
        </div>
        <div class="col-md-6">
            {{ form_row(form.modele) }}
        </div>
        <div class="col-md-6">
            {{ form_row(form.immatriculation) }}
        </div>
        <div class="col-md-6">
            {{ form_row(form.kilometrage) }}
        </div>
        <div class="col-md-4">
            {{ form_row(form.delaiAssurance) }}
        </div>
        <div class="col-md-4">
            {{ form_row(form.delaiTVM) }}
        </div>
        <div class="col-md-4">
            {{ form_row(form.delaiVisiteTechnique) }}
        </div>
        <div class="col-md-4">
            {{ form_row(form.typeMoteur) }}
        </div>
        <div class="col-md-4">
            {{ form_row(form.puissance) }}
        </div>
        <div class="col-md-4">
            {{ form_row(form.capacite) }}
        </div>

    </div>
    </div>

<div id="ordinateur">
    <div class="row" >
        <div class="col-md-4">
            {{ form_row(form.processeur) }}
        </div>
        <div class="col-md-4">
            {{ form_row(form.frequence) }}
        </div>
        <div class="col-md-4">
            {{ form_row(form.memoireRAM) }}
        </div>
        <div class="col-md-4">
            {{ form_row(form.disqueDur) }}
        </div>
        <div class="col-md-4">
            {{ form_row(form.capaciteDisqueDur) }}
        </div>
        <div class="col-md-4">
            {{ form_row(form.OS) }}
        </div>
    </div>
</div>

    <div id="imprimante">
        <div class="row">
            <div class="col-md-4">
                {{ form_row(form.typeImprimante) }}
            </div>
            <div class="col-md-4">
                {{ form_row(form.vitesseImpression) }}
            </div>
            <div class="col-md-4">
                {{ form_row(form.PPM) }}
            </div>
            <div class="col-md-6">
                {{ form_row(form.resolutionImpression) }}
            </div>
            <div class="col-md-6">
                {{ form_row(form.connectivite) }}
            </div>
        </div>
    </div>
<div class="row" >
    <div class="col-md-6">
        {{ form_row(form.libelle) }}
    </div>
    <div class="col-md-6">
        {{ form_row(form.imageFile) }}
    </div>
</div>

{% endblock %}

