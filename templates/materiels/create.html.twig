{% extends 'base_formulaire.html.twig' %}

{% block title %}Ajouter un Matériel{% endblock %}
{% block breadcrumb %}Materiel{% endblock %}
{% block  breadcrumb_item %} Gestion des Materiel{% endblock %}
{% block  breadcrumb_t %} Nouvel materiel{% endblock %}
{% block annuler %} {{ path('materiels_index') }}{% endblock %}
{% block form_titre %}Ajouter un Matériel{% endblock %}

{% block formContent %}
    {{ form_start(form, {'attr': {'id': 'materiel', 'novalidate': 'novalidate'}}) }}

    <div class="row">
        <div class="col-md-6">
            {{ form_row(form.type) }}
        </div>
        <div class="col-md-6">
            {{ form_row(form.name) }}
        </div>


        <div class="col-md-6">
            {{ form_row(form.date_acquisition) }}
        </div>
        <div class="col-md-6">
            {{ form_row(form.coutAcquisition) }}
        </div>
        <div class="col-md-6">
            {{ form_row(form.numeroSerie) }}
        </div>
        <div class="col-md-6">
            {{ form_row(form.statutMateriel) }}
        </div>

    </div>
    <div id="vehicule">
