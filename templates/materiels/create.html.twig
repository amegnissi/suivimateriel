{% block javascript %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const typeBolSelect = document.getElementById('materiel_type');
    const conditionalFields = document.getElementById('vehicule');
console.log(conditionalFields);
    // Fonction pour recharger le formulaire avec les champs conditionnels
    function reloadFormWithConditionalFields() {
        const formData = new FormData(document.getElementById('materiel'));

        fetch(window.location.href, {
            method: 'POST',
            body: formData,
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
            .then(response => response.text())
            .then(html => {
                const parser = new DOMParser();
                const doc = parser.parseFromString(html, 'text/html');
                const newConditionalFields = doc.getElementById('vehicule');
                console.log(doc);
                if (newConditionalFields) {
                    conditionalFields.innerHTML = newConditionalFields.innerHTML;
                    console.log(newConditionalFields.innerHTML);
                }
            })
            .catch(error => {
                console.error('Erreur lors du rechargement des champs:', error);
            });
    }

    // Écouter les changements sur le select du type de bol
    typeBolSelect.addEventListener('change', function() {
        if (this.value) {

            reloadFormWithConditionalFields();
        } else {
            // Vider les champs conditionnels si aucun type n'est sélectionné
            conditionalFields.innerHTML = '';
        }
    });
});
