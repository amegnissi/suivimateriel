    document.addEventListener('DOMContentLoaded', function () {
        const serviceSelect = document.getElementById('materiel_type');
         const chambreContainer = document.getElementById('vehicule');
    const ordinateurContainer = document.getElementById('ordinateur');
    const imprimanteContainer = document.getElementById('imprimante');
         function toggleChambreField() {
             const selectedText = serviceSelect.options[serviceSelect.selectedIndex].text.toLowerCase();
 console.log(selectedText);
             if (selectedText.includes('véhicule')) {
                 chambreContainer.style.display = 'block';
    ordinateurContainer.style.display = 'none';
    imprimanteContainer.style.display = 'none';

             }
             else if ((selectedText.includes('ordinateur de bureau')) || (selectedText.includes('ordinateur portatif'))) {
    chambreContainer.style.display = 'none';
    ordinateurContainer.style.display = 'block';
    imprimanteContainer.style.display = 'none';
}
    else if ((selectedText.includes('imprimante'))) {
    chambreContainer.style.display = 'none';
    ordinateurContainer.style.display = 'none';
    imprimanteContainer.style.display = 'block';
}
             else {
                 chambreContainer.style.display = 'none';
    ordinateurContainer.style.display = 'none';
    imprimanteContainer.style.display = 'none';
                 // Optionally clear chambre selection
                 const chambreSelect = chambreContainer.querySelector('select');
                 if (chambreSelect) {
                     chambreSelect.value = '';
                 }
             }
         }

        serviceSelect.addEventListener('change', toggleChambreField);

//         // Initial check on page load
         toggleChambreField();
    });
</script>
{% endblock %}
