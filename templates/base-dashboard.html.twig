<!DOCTYPE html>
<!--
This is a starter template page. Use this page to start your new project from
scratch. This page gets rid of all links and provides the needed markup only.
-->
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title> 
    {% block title %}
				Accueil
			{% endblock %} | E-SUIVI - Gestion des matériels et courriers
     </title>

    <!-- Google Font: Source Sans Pro 
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">-->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <!-- Google Font: Inter, SUSE, Source Sans Pro -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Source+Sans+Pro:wght@400;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=SUSE:ital,wght@0,400;0,600;0,700&display=swap" rel="stylesheet">
    
    <!-- Font Awesome Icons  -->
    <link rel="stylesheet" href="{{ asset('adminlte/plugins/fontawesome-free/css/all.min.css') }}">   
    <link rel="stylesheet" href="https://code.ionicframework.com/ionicons/2.0.1/css/ionicons.min.css">
    
    <!-- Theme style -->
    

    {% block css %}

    {% endblock %}
    <link rel="stylesheet" href="{{ asset('adminlte/css/adminlte.css') }}">
    <link rel="stylesheet" href="{{ asset('adminlte/css/base.css') }}">
    <link rel="stylesheet" href="{{ asset('adminlte/css/dashboard.css') }}">
</head>
<body class="hold-transition sidebar-mini">
<div class="wrapper">

    <!-- Navbar -->
     {% include "partials/navbar.html.twig" with {
      bg_navbar:'border-bottom nav-light'
     } %}
    <!-- /.navbar -->

    <!-- Main Sidebar Container -->
    <aside class="main-sidebar sidebar-dark-primary">
        <!-- Brand Logo -->
        <a href="{{ path('dashboard') }}" class="brand-link border-end">
            <img src="{{ asset('data/app/app-logo.png') }}" alt="Logo E-suivi"
                 class="brand-image" >
        </a>

        <!-- Sidebar -->
        <div class="sidebar">
            <!-- Sidebar user panel (optional) -->
            <div class="user-panel pb-3 mb-3 d-flex">
{#                <div class="image">#}
{#                    <img src="{{ asset('assets/admin/img/avatar.png') }}" class="img-circle elevation-2"#}
{#                         alt="User Image">#}
{#                </div>
                {% if app.user %}
                <div class="info">
                    <a href="#" class="d-block">{{ app.user.name }}</a>
                </div>
                {% endif %}
            </div>#}


            <!-- Sidebar Menu -->
            {% include "partials_adminlte/_menu_base.html.twig" %}
            <!-- /.sidebar-menu -->
        </div>
        <!-- /.sidebar -->
    </aside>

    <!-- Content Wrapper. Contains page content -->
    <div class="content-wrapper">
        <!-- Content Header (Page header) -->
        {% set _title = block('title') is defined ? block('title') : '' %}
        {% set _breadcrumb = block('breadcrumb') is defined ? block('breadcrumb') : '' %}
        {% set _breadcrumb_item = block('breadcrumb_item') is defined ? block('breadcrumb_item') : '' %}
        {% set _breadcrumb_t = block('breadcrumb_t') is defined ? block('breadcrumb_t') : '' %}
        {% set _btntitle = block('btntitle') is defined ? block('btntitle') : '' %}
        {% set _btnpath = block('btnpath') is defined ? block('btnpath') : '' %}
        {% set _otherbtn = block('otherbtn') is defined ? block('otherbtn') : '' %}

        {% block page_header %}
            {% include 'partials_adminlte/_breadcumb.html.twig' with {
                title: _title,
                breadcrumb: _breadcrumb,
                breadcrumb_item: _breadcrumb_item,
                breadcrumb_t: _breadcrumb_t,
                btntitle: _btntitle,
                btnpath: _btnpath,
                otherbtn: _otherbtn
            } %}
        {% endblock %}



        
        {# templates/partials_adminlte/_breadcrumb.html.twig #}
       

        <!-- /.content-header -->

        <!-- Main content -->
        {#        <div class="content"> #}
        <div class="container">
            {% block content %}
            {% endblock %}
            <!-- /.row -->
        </div><!-- /.container-fluid -->
        {#        </div> #}
        <!-- /.content -->
    </div>
    <!-- /.content-wrapper -->


    <!-- /.control-sidebar -->

    <!-- Main Footer -->
{#    <footer class="main-footer">#}
{#        <!-- To the right -->#}
{#        <div class="float-right d-none d-sm-inline">#}
{#            Anything you want#}
{#        </div>#}
{#        <!-- Default to the left -->#}
{#        <strong>Copyright &copy; 2014-2021 <a href="https://adminlte.io">AdminLTE.io</a>.</strong> All rights reserved.#}
{#    </footer>#}
</div>
<!-- ./wrapper -->

<!-- REQUIRED SCRIPTS -->

<!-- jQuery -->
<script src="{{ asset('adminlte/plugins/jquery/jquery.js') }}"></script>
<!-- Bootstrap 5 
<script src="{{ asset('adminlte/plugins/bootstrap/js/bootstrap.bundle.js') }}"></script>-->
<!-- Bootstrap JS (avec Popper.js) -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<!-- AdminLTE App -->
<script src="{{ asset('adminlte/js/adminlte.js') }}"></script>
{% block javascript %}
{% endblock %}
</body>
</html>
