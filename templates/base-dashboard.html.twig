<script src="https://unpkg.com/@barba/core"></script>
<script>
  //$(document).ready(function () {
    $('#loader').fadeOut(200);
    //barba
     barba.init({
      transitions: [
        {
          name: 'fade',
          leave(data) {
            return new Promise(resolve => {
              data.current.container.classList.add('opacity-75');
              $('#loader').fadeIn(0);
              setTimeout(resolve, 500);
            });
          },
          enter(data) {
            data.next.container.classList.add('opacity-100');
            setTimeout(() => {
              $('#loader').fadeOut(200);
              data.next.container.classList.add('opacity-100');
            }, 0);
          }
        }
      ]
    });
 // }); 
</script>

